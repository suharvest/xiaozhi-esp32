        Select display style for Xiaozhi device

    config USE_DEFAULT_MESSAGE_STYLE
        bool "Enable default message style"

    config USE_WECHAT_MESSAGE_STYLE
        bool "Enable WeChat Message Style"

    config USE_EMOTE_MESSAGE_STYLE
        bool "Emote animation style"
        depends on BOARD_TYPE_ESP32_S3_BOX || BOARD_TYPE_ESP32_S3_BOX_3 \
            || BOARD_TYPE_ESP_VOCAT || BOARD_TYPE_LICHUANG_DEV_S3 || BOARD_TYPE_RYMCU_BIGSMART \
            || BOARD_TYPE_ESP_SENSAIRSHUTTLE
endchoice

config USE_MULTILINE_CHAT_MESSAGE
    bool "Use multiline chat message display (default mode only)"
    depends on USE_DEFAULT_MESSAGE_STYLE
    default n
    help
        When enabled, the chat message area in the default display mode shows
        multiple wrapped lines that grow upward from the bottom of the screen,
        with auto-adaptive height.
        When disabled (default), a single-line horizontally scrolling label
        is shown at the bottom of the screen.

choice WAKE_WORD_TYPE
    prompt "Wake Word Implementation Type"
    default USE_AFE_WAKE_WORD if (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4 || IDF_TARGET_ESP32S31) && SPIRAM
    default WAKE_WORD_DISABLED
    help
        Choose the type of wake word implementation to use

    config WAKE_WORD_DISABLED
        bool "Disabled"
        help
            Disable wake word detection

    config USE_ESP_WAKE_WORD
        bool "Wakenet model without AFE"
        depends on IDF_TARGET_ESP32C3 || IDF_TARGET_ESP32C5 || IDF_TARGET_ESP32C6 || (IDF_TARGET_ESP32 && SPIRAM)
        help
            Support ESP32 C3、ESP32 C5 与 ESP32 C6, and (ESP32 with PSRAM)

    config USE_AFE_WAKE_WORD
        bool "Wakenet model with AFE"
        depends on (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4 || IDF_TARGET_ESP32S31) && SPIRAM
        help
            Support AEC if available, requires ESP32-S3, ESP32-P4, or ESP32-S31 and PSRAM

    config USE_CUSTOM_WAKE_WORD
        bool "Multinet model (Custom Wake Word)"
        depends on (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4 || IDF_TARGET_ESP32S31) && SPIRAM
        help
            Requires ESP32-S3, ESP32-P4, or ESP32-S31 and PSRAM

endchoice

config CUSTOM_WAKE_WORD
    string "Custom Wake Word"
    default "xiao tu dou"
    depends on USE_CUSTOM_WAKE_WORD
    help
        Custom Wake Word, use pinyin for Chinese, separated by spaces

config CUSTOM_WAKE_WORD_DISPLAY
    string "Custom Wake Word Display"
    default "小土豆"
    depends on USE_CUSTOM_WAKE_WORD
    help
        Greeting sent to the server after wake word detection

config CUSTOM_WAKE_WORD_THRESHOLD
    int "Custom Wake Word Threshold (%)"
    default 20
    range 1 99
    depends on USE_CUSTOM_WAKE_WORD
    help
        Custom Wake Word Threshold, range 1-99, the smaller the more sensitive, default 20

config SEND_WAKE_WORD_DATA
    bool "Send Wake Word Data"
    default y
    depends on USE_AFE_WAKE_WORD || USE_CUSTOM_WAKE_WORD
    help
        Send wake word data to the server as the first message of the conversation and wait for response

config WAKE_WORD_DETECTION_IN_LISTENING
    bool "Enable Wake Word Detection in Listening Mode"
    default n
    depends on USE_AFE_WAKE_WORD || USE_CUSTOM_WAKE_WORD
    help
        Enable wake word detection while in listening mode.
        When enabled, the device can detect wake word during listening,
        which allows interrupting the current conversation.
        When disabled (default), wake word detection is turned off during listening.

config SKIP_WIFI_PROVISIONING
    bool "Skip Wi-Fi Provisioning At Boot"
    default n
    help
        Do not run the Wi-Fi bring-up at boot. The board's StartNetwork() goes
        straight to the idle state instead, so WifiManager is never initialised:
        no station scan, no configuration access point, no DNS or web server,
        and no looping setup prompt.

        For devices that reach their host over another transport, such as USB,
        where there is nothing to provision and the provisioning prompt only
        gets in the way of on-device audio testing.

        Nothing reports a network connection afterwards, so activation and the
        protocol client never start. Wake word detection still runs, and the
        protocol errors that follow a wake word are left in place on purpose.

config AUDIO_I2S_TX_ALWAYS_ENABLED
    bool "Keep The I2S TX Channel Enabled While Capturing"
    default n
    help
        Enable the TX channel whenever the input is on, and keep it running
        when playback stops, as long as the input is still on.

        In full-duplex STD mode the driver forces the later initialised channel
        to the slave role and shares BCLK and WS between the two directions, so
        those clocks come from the TX channel. Enabling RX on its own then
        leaves the bus without a clock: a slave codec sends nothing and every
        read times out. This keeps the clock running for as long as the
        microphone is in use.

        The idle TX channel sends silence, not noise, because the channel is
        allocated with auto_clear_after_cb.

        Keep the default: boards whose capture works without playback need no
        change. Override it per board in the board config.json.

config XVF3800_DUMP_CONFIG
    bool "Read Back The XVF3800 Configuration At Boot"
    default n
    help
        Query the XVF3800 over its I2C host control interface at boot and log
        the firmware version, the mux routing of both I2S output slots, the
        microphone gain and the AGC and ASR-output settings.

        Read only: nothing on the device is changed. It answers what the two
        captured slots actually carry, which otherwise has to be guessed from
        signal levels.

        Only for boards that wire the XVF3800 control interface to the same
        I2C bus as the rest of the board.

config XVF3800_APPLY_TUNING
    bool "Write Tuning Values To The XVF3800 At Boot"
    default n
    depends on XVF3800_DUMP_CONFIG
    help
        After reading the configuration back, write one tuning parameter to
        the device. Each write reads the old value first, writes, then reads
        again, and logs all three, so a write that does not take effect is
        visible.

        SAVE_CONFIGURATION is never issued, so nothing reaches the device's
        flash: a power cycle restores whatever was there before.

config XVF3800_SET_AGC_DESIRED_LEVEL
    bool "Write PP_AGCDESIREDLEVEL"
    default y
    depends on XVF3800_APPLY_TUNING

config XVF3800_AGC_DESIRED_LEVEL_PPM
    int "AGC Target Output Power, In Parts Per Million"
    default 20000
    range 1 1000000
    depends on XVF3800_SET_AGC_DESIRED_LEVEL
    help
        PP_AGCDESIREDLEVEL is the target power of the output signal, valid
        from 1e-8 to 1.0. Kconfig has no floats, so it is given here in parts
        per million: 20000 means 0.02, which is a target RMS amplitude of
        sqrt(0.02) = 0.141, about 4635 on the int16 scale.

config XVF3800_SET_AGC_MAX_GAIN
    bool "Write PP_AGCMAXGAIN"
    default n
    depends on XVF3800_APPLY_TUNING

config XVF3800_AGC_MAX_GAIN_MILLI
    int "Maximum AGC Gain, In Thousandths"
    default 128000
    range 1000 1000000
    depends on XVF3800_SET_AGC_MAX_GAIN
    help
        PP_AGCMAXGAIN is a linear gain factor, valid from 1.0 to 1000.0.
        Kconfig has no floats, so it is given here in thousandths: 128000
        means 128.0.

        Raise this when the reported AGC_GAIN has reached AGC_MAX_GAIN and the
        output still sits below AGC_DESIRED_LEVEL: the loop has no headroom
        left to close the gap.

config XVF3800_SET_MIN_NN
    bool "Write PP_MIN_NN"
    default n
    depends on XVF3800_APPLY_TUNING

config XVF3800_MIN_NN_MILLI
    int "Non-Stationary Noise Suppression Gain Floor, In Thousandths"
    default 200
    range 0 1000
    depends on XVF3800_SET_MIN_NN
    help
        PP_MIN_NN is the gain floor for non-stationary noise suppression,
        valid from 0.0 to 1.0, where a smaller value suppresses harder.
        Kconfig has no floats, so it is given here in thousandths: 200 means
        0.20.

        Lower this when raising the AGC gain also raised the noise floor by
        the same factor, which leaves the signal-to-noise ratio unchanged.
        Too low eats quiet speech, which shows up as a wake word score that
        drops instead of rising.

config XVF3800_SET_MIN_NS
    bool "Write PP_MIN_NS"
    default n
    depends on XVF3800_APPLY_TUNING

config XVF3800_MIN_NS_MILLI
    int "Stationary Noise Suppression Gain Floor, In Thousandths"
    default 150
    range 0 1000
    depends on XVF3800_SET_MIN_NS
    help
        PP_MIN_NS is the gain floor for stationary noise suppression, valid
        from 0.0 to 1.0, where a smaller value suppresses harder. In
        thousandths: 150 means 0.15.

        The steady background hum. Adjust it after PP_MIN_NN, one at a time.

config USE_V2V_USB_PROTOCOL
    bool "Talk To The Host Over USB Instead Of The Network"
    default n
    select AUDIO_PCM_PASSTHROUGH
    help
        Use the V2vProtocol implementation, which carries control messages and
        raw PCM over the USB-Serial-JTAG link to a host agent instead of using
        WebSocket or MQTT over Wi-Fi.

        The protocol is created during start-up rather than after a network
        connection, so it also works on boards that skip Wi-Fi provisioning
        altogether.

config AUDIO_PCM_PASSTHROUGH
    bool "Send And Receive Raw PCM Instead Of Opus"
    default n
    help
        Bypass the Opus encoder and decoder and move S16LE 16 kHz mono samples
        as they are. For a link that is not bandwidth limited, such as USB CDC,
        the codec only adds latency and CPU load.

        Uplink is re-chunked into fixed 20 ms frames (320 samples, 640 bytes)
        regardless of the size the audio pipeline hands over, so the wire frame
        length stays constant. Downlink takes whatever length arrives.

config AUDIO_I2S_SLAVE_ROLE
    bool "ESP Is The I2S Slave"
    default n
    help
        Allocate the duplex I2S channels with the slave role, so BCLK and WS
        are taken from the other device instead of being generated here.

        Needed when the attached codec or DSP drives the bus itself. Leaving
        both sides as master puts a clock on the wire, so reads appear to
        succeed, but the sampling phase has no relation to the sender's frame
        boundary: the captured words are a bit-rotated view of the real stream
        and the rotation is different on every power-up.

        The driver turns the BCLK and WS pins into inputs by itself in this
        role. Playback is then paced by the external clock, so a write blocks
        for as long as that clock is missing.

        Keep the default. Override it per board in the board config.json.

config AUDIO_I2S_INPUT_BIT_OFFSET
    int "I2S Input Bit Offset Correction"
    default 0
    range 0 31
    help
        Re-slice the captured I2S bit stream this many bits later before it is
        converted to int16. 0 leaves the stream untouched.

        Use it when the payload's sign bit does not sit at the top of each
        captured 32-bit word, which shows up as raw words whose run of sign
        bits starts a few bits below bit 31 and whose full-scale ratios land on
        neat binary fractions. The correction is causal: it carries one word
        between reads, so the two slots come out one slot later than they went
        in, which swaps which slot appears first.

        Keep the default. Override it per board in the board config.json.

config AUDIO_I2S_MSB_JUSTIFIED
    bool "I2S Input/Output Is MSB (Left) Justified"
    default n
    help
        Clear the driver's bit_shift flag, so data starts on the word select
        edge (MSB/left-justified) instead of one bit clock after it (Philips).
        A one bit clock difference; nothing else changes.

config AUDIO_I2S_LEFT_ALIGN
    bool "I2S Left Align The Data In The Slot"
    default y
    help
        The driver's left_align flag, which only exists on I2S hardware
        version 2. Leave it on unless the source right-aligns its payload
        inside the slot.

config AUDIO_I2S_WS_WIDTH
    int "I2S Word Select Width In Bit Clocks"
    default 32
    range 8 32
    help
        How many bit clocks the word select stays on each side of the frame.
        32 matches a 32-bit slot.

config AUDIO_I2S_INPUT_STEREO
    bool "Read Both I2S Input Slots (Stereo Capture)"
    default n
    help
        Capture both 32-bit slots of each I2S frame instead of only the left
        one, and hand the first slot upstream. The wire format does not change
        (two 32-bit slots per frame either way); only the RX side of the driver
        keeps both slots rather than discarding the right one. TX is untouched.

        Needed when the source puts different signals on the two slots, such as
        a DSP that sends processed microphone audio on one and an echo
        cancellation reference on the other, and the upstream mono path must
        pick the right one. With AUDIO_INPUT_LEVEL_DEBUG on, both slots get
        their own level statistics so they can be told apart.

        Keep the default: boards whose microphone sits on the left slot need no
        change. Override it per board in the board config.json.

config AUDIO_I2S_INPUT_SHIFT
    int "I2S Input Right-Shift From 32-bit Slot To int16"
    default 12
    range 0 24
    help
        How far NoAudioCodec::Read() shifts each 32-bit I2S slot word right
        before clamping it to int16.

        16 is the neutral 32-to-16 conversion. The default 12 keeps 4 extra
        bits, i.e. 16x gain, which is what 24-bit left-justified MEMS
        microphones (INMP441, ICS-43434 and friends) need to reach usable
        levels. Sources that already deliver line-level audio, such as a DSP
        doing its own AGC, want 16 instead; leaving it at 12 saturates them.

        Do not change the default: boards relying on the 16x gain would go
        quiet. Override it per board in the board config.json.

config AUDIO_INPUT_LEVEL_DEBUG
    bool "Log Microphone Input Level (Debug)"
    default n
    help
        Print periodic statistics (about once per second) of the PCM read from
        the microphone before it reaches the audio engine: RMS, peak, min, max
        and sample count, plus a one-shot dump of the first raw I2S words and
        the first int16 samples.

        Use it to tell "nobody is talking" apart from "no audio is arriving",
        and to check that the 16 bits taken out of a 32-bit I2S slot are the
        right ones. Debug aid only, keep it off in production.

config WAKE_WORD_IN_WIFI_CONFIGURING
    bool "Keep Wake Word Detection Running While Wi-Fi Configuring"
    default n
    depends on !WAKE_WORD_DISABLED
    help
        By default the device turns voice processing and wake word detection off
        while it sits in Wi-Fi configuration mode (AP provisioning), so it does
        not answer speech before it is set up.

        Wake word detection is pure on-device inference and needs no network.
        Enabling this keeps it running in that state, mirroring the Idle state
        (uplink off, wake word on), so the wake word can be validated and
        troubleshooted on a device that is not provisioned yet or whose Wi-Fi
        connection failed.

config WAKE_WORD_REARM_WITHOUT_PROTOCOL
    bool "Re-Arm The Wake Word When There Is No Protocol"
    default n
    help
        With no protocol client the wake word handler returns immediately, and
        because the detector disarms itself on every hit, the device can only
        be woken once per boot. That makes the detection score impossible to
        sample repeatedly, and a single score is far too noisy to tune
        against.

        Enabling this re-arms the detector after each hit instead, so the wake
        word can be exercised as many times as needed. It only changes the
        path taken when no protocol exists; once a transport is attached the
        handler runs exactly as before.

config WAKE_WORD_REARM_DELAY_MS
    int "Delay Before Re-Arming The Wake Word (ms)"
    default 1000
    range 0 10000
    depends on WAKE_WORD_REARM_WITHOUT_PROTOCOL
    help
        Wait this long after a hit before listening again, so the tail or the
        reverberation of the same utterance does not trigger a second one.

config VAD_BARGE_IN
    bool "Interrupt Speaking on Voice Activity"
    default y
    help
        Abort the current TTS playback when the AFE VAD reports human speech
        while the device is speaking, without waiting for the wake word.
        Only effective while voice processing keeps running during playback
        (real-time listening mode, i.e. AEC enabled).

config VAD_BARGE_IN_MIN_SPEAKING_MS
    int "Minimum Speaking Time Before Barge-in (ms)"
    default 500
    range 0 5000
    depends on VAD_BARGE_IN
    help
        Ignore VAD activity during the first N milliseconds of playback. The AEC
        needs time to converge; without this guard the device echo triggers a
        false barge-in immediately after playback starts.

config USE_AUDIO_PROCESSOR
    bool "Enable AFE Audio Processing"
    default y
    depends on (IDF_TARGET_ESP32S3 || IDF_TARGET_ESP32P4 || IDF_TARGET_ESP32S31) && SPIRAM
    help
        Enable the shared AFE uplink path with AEC and VAD. Noise suppression
        is not enabled because this project does not provide an NSNet model.
        Requires ESP32-S3, ESP32-P4, or ESP32-S31 with PSRAM.

config USE_DEVICE_AEC
    bool "Enable Device-Side AEC"
    default n
        depends on USE_AUDIO_PROCESSOR && (BOARD_TYPE_ESP32_S3_BOX_3 || BOARD_TYPE_ESP32_S3_BOX || BOARD_TYPE_ESP32_S3_BOX_LITE \
        || BOARD_TYPE_LICHUANG_DEV_S3 || BOARD_TYPE_RYMCU_BIGSMART || BOARD_TYPE_ESP32_S3_KORVO_2_V3 || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_AMOLED_1_75|| BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_AMOLED_1_75C || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_LCD_1_83\
        || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_AMOLED_2_06 || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_LCD_4B || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_4B || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_4_3 || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_5 \
        || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_7B \
        || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_3_4C || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_4C || BOARD_TYPE_ESP32_S3_LCD_EV_BOARD_2 || BOARD_TYPE_YUNLIAO_S3 \
        || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_7 || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_8 || BOARD_TYPE_WAVESHARE_ESP32_P4_WIFI6_TOUCH_LCD_10_1 \
        || BOARD_TYPE_ESP_VOCAT || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_LCD_3_49 || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_LCD_3_49_V2 || BOARD_TYPE_WAVESHARE_ESP32_S3_RLCD_4_2 || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_LCD_1_85B || BOARD_TYPE_ZHENGCHEN_CAM || BOARD_TYPE_ZHENGCHEN_CAM_ML307 \
        || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_LCD_4_3C || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_LCD_1_54 || BOARD_TYPE_WAVESHARE_ESP32_S3_LCD_0_85 || BOARD_TYPE_AI_VOX3 || BOARD_TYPE_WAVESHARE_ESP32_S3_TOUCH_AMOLED_1_43C || BOARD_TYPE_ATK_DNESP32S3_BOX3)
    help
        To work properly, device-side AEC requires a clean output reference path from the speaker signal and physical acoustic isolation between the microphone and speaker.

config EXTERNAL_HARDWARE_AEC
    bool "AEC Done by External Hardware Upstream of the ESP32"
    default n
    depends on USE_AUDIO_PROCESSOR
    help
        Select this when echo cancellation happens in external hardware sitting
        upstream of the ESP32 (for example the XVF3800 DSP on ReSpeaker Flex),
        so the microphone stream reaching the ESP32 is already echo-free.

        The AFE therefore does not run AEC again, but it must keep VAD enabled,
        which is why this is not USE_DEVICE_AEC. Enabling this keeps the device
        in real-time listening mode during playback, so voice processing is not
        switched off while speaking and VAD barge-in stays usable.

config USE_SERVER_AEC
    bool "Enable Server-Side AEC (Unstable)"
    default n
    depends on USE_AUDIO_PROCESSOR
    help
        To work perperly, server-side AEC requires server support

config USE_AUDIO_DEBUGGER
    bool "Enable Audio Debugger"
    default n
    help
        Enable audio debugger, send audio data through UDP to the host machine

menu "WiFi Configuration Method"
    help
        WiFi Configuration Method Selection
    config USE_HOTSPOT_WIFI_PROVISIONING
        bool "Hotspot"
        default y
        help
            Use WiFi Hotspot to transmit WiFi configuration data
    config USE_ESP_BLUFI_WIFI_PROVISIONING
        bool "ESP-BluFi"
        select BT_ENABLED
        select BT_BLE_42_FEATURES_SUPPORTED
        select BT_BLE_BLUFI_ENABLE
        help
            Use the PSA Crypto based BluFi security protocol adopted by ESP-IDF 6.
            The provisioning client must support ffdhe3072, SHA-256, and AES-CTR.
endmenu

config AUDIO_DEBUG_UDP_SERVER
    string "Audio Debug UDP Server Address"
    default "192.168.2.100:8000"
    depends on USE_AUDIO_DEBUGGER
    help
        UDP server address, format: IP:PORT, used to receive audio debugging data

config RECEIVE_CUSTOM_MESSAGE
    bool "Enable Custom Message Reception"
    default n
    help
        Enable custom message reception, allow the device to receive custom messages from the server (preferably through the MQTT protocol)

menu "Camera Configuration"
    depends on !IDF_TARGET_ESP32

    comment "Warning: Please read the help text before modifying these settings."

    config XIAOZHI_CAMERA_MIRROR_CONFIGURED
        bool "Override camera mirror settings"
        default n
        help
            When enabled, the common camera implementations apply the
            horizontal and vertical mirror settings below after the sensor has
            been initialized. Parameterized builds enable this automatically
            when either mirror setting is configured.

    config XIAOZHI_CAMERA_HMIRROR
        bool "Mirror Camera Horizontally"
        default n
        depends on XIAOZHI_CAMERA_MIRROR_CONFIGURED
        help
            Flip the captured camera image across the vertical axis.

    config XIAOZHI_CAMERA_VFLIP
        bool "Mirror Camera Vertically"
        default n
        depends on XIAOZHI_CAMERA_MIRROR_CONFIGURED
        help
            Flip the captured camera image across the horizontal axis.

    config XIAOZHI_CAMERA_ALLOW_JPEG_INPUT
        bool "Allow JPEG Input"
        default n
        help
            Allow JPEG Input format for the camera.

            This option may need to be enabled when using a USB camera.

            Not currently supported when used simultaneously with XIAOZHI_ENABLE_ROTATE_CAMERA_IMAGE.

    config XIAOZHI_ENABLE_HARDWARE_JPEG_ENCODER
        bool "Enable Hardware JPEG Encoder"
        default y
        depends on SOC_JPEG_ENCODE_SUPPORTED
        help
            Use hardware JPEG encoder on ESP32-P4 to encode image to JPEG.
            See https://docs.espressif.com/projects/esp-idf/en/stable/esp32p4/api-reference/peripherals/jpeg.html for more details.

    config XIAOZHI_ENABLE_HARDWARE_JPEG_DECODER
        bool "Enable Hardware JPEG Decoder"
        default n
        depends on SOC_JPEG_DECODE_SUPPORTED && XIAOZHI_CAMERA_ALLOW_JPEG_INPUT
        help
            Use hardware JPEG decoder on ESP32-P4 to decode JPEG to image.
            See https://docs.espressif.com/projects/esp-idf/en/stable/esp32p4/api-reference/peripherals/jpeg.html for more details.

    config XIAOZHI_ENABLE_CAMERA_DEBUG_MODE
        bool "Enable Camera Debug Mode"
        default n
        help
            Enable camera debug mode, print camera debug information to the console.
            Only works on boards that support camera.

    config XIAOZHI_ENABLE_CAMERA_ENDIANNESS_SWAP
        bool "Enable software camera buffer endianness swapping"
        default n
        depends on !CAMERA_SENSOR_SWAP_PIXEL_BYTE_ORDER
        help
            This option treats the camera buffer as a uint16_t[] array and performs byte-swapping (endianness conversion) on each element.

            Should only be modified by development board integration engineers.

            **Incorrect usage may result in incorrect image colors!**

            ATTENTION: If the option CAMERA_SENSOR_SWAP_PIXEL_BYTE_ORDER is available for your sensor, please use that instead.

    menuconfig XIAOZHI_ENABLE_ROTATE_CAMERA_IMAGE
        bool "Enable Camera Image Rotation"
        default n
        depends on !XIAOZHI_CAMERA_ALLOW_JPEG_INPUT
        help
            Enable camera image rotation, rotate the camera image to the correct orientation.
            - On ESP32-P4, rotation is handled by PPA hardware.
            - On other chips, rotation is done in software with performance cost.
            - For 180° rotation, use HFlip + VFlip instead of this option.

            Not currently supported when used simultaneously with XIAOZHI_CAMERA_ALLOW_JPEG_INPUT.

    if XIAOZHI_ENABLE_ROTATE_CAMERA_IMAGE
        choice XIAOZHI_CAMERA_IMAGE_ROTATION_ANGLE
            prompt "Camera Image Rotation Angle (clockwise)"
            default XIAOZHI_CAMERA_IMAGE_ROTATION_ANGLE_90
            help
                Camera image rotation angle.
            config XIAOZHI_CAMERA_IMAGE_ROTATION_ANGLE_90
                bool "90°"
            config XIAOZHI_CAMERA_IMAGE_ROTATION_ANGLE_270
                bool "270°"
            comment "For 180° rotation, use HFlip + VFlip instead of this option"
        endchoice
    endif
endmenu

menu "TAIJIPAI_S3_CONFIG"
    depends on BOARD_TYPE_TAIJI_PI_S3
    choice I2S_TYPE_TAIJIPI_S3
        prompt "taiji-pi-S3 I2S Type"
        default TAIJIPAI_I2S_TYPE_STD
        help
            I2S 类型选择
        config TAIJIPAI_I2S_TYPE_STD
            bool "I2S Type STD"
        config TAIJIPAI_I2S_TYPE_PDM
            bool "I2S Type PDM"
    endchoice

    config I2S_USE_2SLOT
    bool "Enable I2S 2 Slot"
    default y
    help
        启动双声道
endmenu

endmenu
