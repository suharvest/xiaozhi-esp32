{
    "type": "respeaker-flex",
    "target": "esp32s3",
    "builds": [
        {
            "name": "respeaker-flex",
            "sdkconfig_append": [
                "CONFIG_BOARD_TYPE_RESPEAKER_FLEX=y",
                "CONFIG_SPIRAM_MODE_OCT=y",
                "CONFIG_ESPTOOLPY_FLASHSIZE_8MB=y",
                "CONFIG_PARTITION_TABLE_CUSTOM_FILENAME=\"partitions/v1/8m_custom_wakeword.csv\"",
                "CONFIG_COMPILER_OPTIMIZATION_SIZE=y",
                "CONFIG_EXTERNAL_HARDWARE_AEC=y",
                "CONFIG_USE_AFE_WAKE_WORD=n",
                "CONFIG_USE_ESP_WAKE_WORD=n",
                "CONFIG_USE_CUSTOM_WAKE_WORD=y",
                "CONFIG_CUSTOM_WAKE_WORD=\"ni hao xiao zhi\"",
                "CONFIG_CUSTOM_WAKE_WORD_DISPLAY=\"你好小智\"",
                "CONFIG_CUSTOM_WAKE_WORD_THRESHOLD=12",
                "CONFIG_SKIP_WIFI_PROVISIONING=y",
                "CONFIG_WAKE_WORD_IN_WIFI_CONFIGURING=y",
                "CONFIG_AUDIO_I2S_INPUT_SHIFT=16",
                "CONFIG_AUDIO_I2S_SLAVE_ROLE=y",
                "CONFIG_AUDIO_I2S_INPUT_BIT_OFFSET=0",
                "CONFIG_AUDIO_I2S_INPUT_STEREO=y",
                "CONFIG_AUDIO_I2S_TX_ALWAYS_ENABLED=y",
                "CONFIG_XVF3800_DUMP_CONFIG=y",
                "CONFIG_XVF3800_APPLY_TUNING=y",
                "CONFIG_XVF3800_AGC_DESIRED_LEVEL_PPM=10000",
                "CONFIG_XVF3800_SET_AGC_MAX_GAIN=y",
                "CONFIG_XVF3800_AGC_MAX_GAIN_MILLI=64000",
                "CONFIG_XVF3800_SET_MIN_NN=y",
                "CONFIG_XVF3800_MIN_NN_MILLI=200",
                "CONFIG_WAKE_WORD_REARM_WITHOUT_PROTOCOL=y",
                "CONFIG_WAKE_WORD_REARM_DELAY_MS=1000",
                "CONFIG_AUDIO_INPUT_LEVEL_DEBUG=y",
                "CONFIG_SR_MN_CN_MULTINET7_QUANT=y",
                "CONFIG_SR_WN_WN9_NIHAOXIAOZHI_TTS=n"
            ]
        }
    ]
}
