# Xiaozhi Remote Display Configuration
# Copy this file to .env and customize as needed

# Device name shown in mDNS discovery and Web UI
RD_DEVICE_NAME=客厅显示器

# Server port
RD_PORT=8765

# Display scale factor (1.0 = original size)
RD_SCALE=1.5

# Enable server-side audio output (HDMI/speaker)
# Default: 0 (audio plays via browser only)
# Set to 1 to also play audio from server
RD_LOCAL_AUDIO=0

# User ID for PulseAudio socket access
# Run `id -u` to get your user ID
PUID=1000

# Timezone
TZ=Asia/Shanghai
